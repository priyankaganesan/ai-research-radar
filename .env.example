# Copy to .env and fill in. Never commit .env.
OLLAMA_HOST=http://127.0.0.1:11434   # use :11435 if the other account's Ollama holds the default port
CHAT_MODEL=qwen3.5:9b
EMBED_MODEL=qwen3-embedding:0.6b
DB_PATH=data/radar.db
CHECKPOINT_DB_PATH=data/checkpoints.db
SEMANTIC_SCHOLAR_API_KEY=            # optional; free key = steadier rate limit for `radar enrich`
# LAB_FEEDS='{"OpenAI": "https://openai.com/news/rss.xml"}'   # override the lab blog list (JSON)
HN_QUERIES=LLM,language model,AI model,arxiv,OpenAI,Anthropic,DeepMind
HN_MIN_POINTS=50
VECTOR_BACKEND=sqlite                # sqlite | lance (run `radar reindex --backend lance` first)
LANCE_PATH=data/lance
LANCE_NPROBES=20                     # IVF partitions scanned per search (once an ANN index exists)
LANCE_REFINE_FACTOR=0                # 0 = off; 10 = re-rank 10x candidates with exact distances
REASON_THINKING=false                # true shows Qwen's reasoning in `radar ask --steps` (slower)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-research-radar

# M1.6: the Q&A graph loads its tools from `radar mcp` over stdio (same behaviour, shows MCP)
TOOLS_VIA_MCP=false
# Daily digest (M2)
INTEREST_TOPICS=LLM agents and tool use,retrieval-augmented generation,reasoning in language models,efficient LLM inference,evaluation of language models
DIGEST_WINDOW_DAYS=7
DIGEST_MIN_TEXT_CHARS=200             # text beyond the title an item needs to be a digest candidate
DIGEST_MODE=single                   # single | multi (M2.5: critic, writer, verifier agents)
VERIFY_ANSWERS=false                 # M2.5: Verifier agent checks each claim of `radar ask` answers
